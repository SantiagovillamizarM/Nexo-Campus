# Copiar este archivo como .env y completar los valores.
# El archivo .env NUNCA se sube al repositorio.

# --- Datos y persistencia ---
# Carpeta con los datos oficiales entregados por Campuslands
DATA_DIR=data/raw
# Archivo de la base de datos SQLite (se crea automáticamente)
DATABASE_PATH=data/nexo_campus.db

# --- Inteligencia Artificial ---
# Cualquier endpoint compatible con la API de OpenAI.
# Gemini (principal): crear la clave en https://aistudio.google.com
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Clave real: SOLO en el .env, nunca en este archivo ni en un commit
AI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite
# Modelo de respaldo si el principal agota su cuota (el plan gratuito limita consultas por día y por modelo)
AI_MODELO_RESPALDO=gemini-2.5-flash
# Respaldo sin internet (Ollama local): usar estas tres líneas en su lugar
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.2:3b
# Tiempo máximo de espera de la IA, en segundos
AI_TIMEOUT=30
